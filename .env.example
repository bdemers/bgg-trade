# Copy to .env and fill in. .env is gitignored; never commit real values.

# The math trade geeklist you are working with. Both tools read this.
# It is the number in the geeklist URL:
#   https://boardgamegeek.com/geeklist/383775/september-2026-us-math-trade
#                                      ^^^^^^
GEEKLIST_ID=

# Your BGG account name, used to download your collection.
BGG_USERNAME=

# Your BGG numeric user ID. This is how the matcher spots which listings in the
# trade are yours, so it can exclude the games you are giving away from your own
# preference profile. Without it those games quietly shape your recommendations.
#
# xmlapi2/user is locked down and returns 401 with or without credentials, so
# setting this by hand avoids a lookup that can no longer succeed. Find it in
# the "author" field of any geeklist item you have posted, or in the URL of your
# own avatar link on BGG.
BGG_USER_ID=

# Method A: cookie auth, preferred by both tools. The GeekSession cookie value
# from boardgamegeek.com.
# Grab it from your browser dev tools under Application > Cookies.
# These expire within hours, so expect to refresh it for each posting run.
GEEK_SESSION=

# Method B: bearer token, used only when GEEK_SESSION is empty. Optional.
BGA_TOKEN=
